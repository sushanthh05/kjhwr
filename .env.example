# Wind Forecast Intelligence — Environment Variable Template
# Copy this file to .env to customize local or Docker Compose configuration

# Host port mapping for Docker Compose Nginx reverse-proxy service (defaults to 8081)
PORT=8081

# Optional comma-separated CORS allowed origins for FastAPI backend
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173
