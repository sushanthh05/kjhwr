# Root .dockerignore for Wind Forecast Intelligence
# Exclude non-runtime, development, secret, and heavy cached files from Docker build context

# Version control
.git
.gitignore

# Python virtual environments & bytecode
.venv/
venv/
ENV/
env/
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
.Python

# Testing & coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node.js & frontend dependencies and build outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files and secrets
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# IDE and OS metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Documentation, scratch scripts and brain artifacts
brain/
docs/
scratch/

# Raw Elexon API response caches (raw JSON responses not needed at runtime)
backend/data/raw/
data/raw/

# PRESERVE canonical processed evaluation dataset required by backend analytics
!backend/data/processed/
!backend/data/processed/**
!data/processed/
!data/processed/**
